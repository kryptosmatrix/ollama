773: def validate_generation(raw, requested_model, expect_served_model=None):
774:     data = parse_json(raw)
775:     if not isinstance(data, dict):
776:         raise ToolError(5, "MALFORMED_RESPONSE", "generation response must be a JSON object")
777:     error_value = data.get("error")
778:     if error_value is not None:
779:         raise ToolError(4, "GENERATION_ERROR", "Ollama error: %s" % safe_display(error_value))
780:     # The served name normally equals the requested tag. Ollama cloud models are
781:     # an exception: the daemon proxies `name:cloud` upstream and the response
782:     # reports the bare `name`, so a strict equality check makes every cloud model
783:     # unusable. `--expect-served-model` lets the caller DECLARE the served
784:     # identity it expects, so the check still happens against a stated value
785:     # rather than being bypassed. There is deliberately no "allow any served
786:     # model" escape: an unchecked identity is exactly what this guard exists to
787:     # prevent, and a review whose model cannot be named is not evidence.
788:     expected_served = expect_served_model or requested_model
789:     served_model = data.get("model")
790:     if served_model != expected_served:
791:         raise ToolError(
792:             3,
793:             "SERVED_MODEL_MISMATCH",
794:             "requested model %s, expected served %s, but response reported %s"
795:             % (requested_model, expected_served, safe_display(served_model)),
796:         )
797:     if data.get("done") is not True:
798:         raise ToolError(5, "INCOMPLETE_RESPONSE", "generation response is not marked done")
799:     done_reason = data.get("done_reason")
800:     if done_reason == "length":
801:         raise ToolError(5, "TRUNCATED_RESPONSE", "generation stopped at the token limit")
802:     if done_reason is not None and not isinstance(done_reason, str):
803:         raise ToolError(5, "MALFORMED_RESPONSE", "done_reason is invalid")
804:     if done_reason not in (None, "stop"):
805:         raise ToolError(
806:             5,
807:             "UNEXPECTED_DONE_REASON",
808:             "generation ended for an unsupported reason: %s" % safe_display(done_reason),
809:         )
810:     response_text = data.get("response")
811:     if not isinstance(response_text, str) or not response_text.strip():
812:         raise ToolError(5, "EMPTY_RESPONSE", "generation returned no response text")
813:     thinking = data.get("thinking")
814:     if thinking is not None and not isinstance(thinking, str):
815:         raise ToolError(5, "MALFORMED_RESPONSE", "thinking field is invalid")
816:     numeric_fields = (
817:         "total_duration",
818:         "load_duration",
819:         "prompt_eval_count",
820:         "prompt_eval_duration",
821:         "eval_count",
822:         "eval_duration",
823:     )
824:     metrics = {}
825:     for field in numeric_fields:
826:         value = data.get(field)
827:         if value is not None:
828:             if not isinstance(value, int) or isinstance(value, bool) or value < 0:
829:                 raise ToolError(5, "MALFORMED_RESPONSE", "%s is invalid" % field)
830:             metrics[field] = value
831:     return {
832:         "response_text": response_text,
833:         "thinking_text": thinking,
834:         "served_model": served_model,
835:         "created_at": safe_display(data.get("created_at"), 128)
836:         if data.get("created_at") is not None
837:         else None,
838:         "done_reason": done_reason,
839:         "metrics": metrics,
840:     }
