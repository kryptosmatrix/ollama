264: def read_prompt(path_text):
265:     requested = pathlib.Path(path_text)
266:     try:
267:         resolved = requested.resolve(strict=True)
268:     except (OSError, RuntimeError) as exc:
269:         raise ToolError(1, "PROMPT_ERROR", "cannot resolve prompt file: %s" % safe_display(exc))
270:     flags = os.O_RDONLY
271:     if hasattr(os, "O_NOFOLLOW"):
272:         flags |= os.O_NOFOLLOW
273:     try:
274:         fd = os.open(str(resolved), flags)
275:     except OSError as exc:
276:         raise ToolError(1, "PROMPT_ERROR", "cannot open prompt file: %s" % safe_display(exc))
277:     try:
278:         info = os.fstat(fd)
279:         if not stat.S_ISREG(info.st_mode):
280:             raise ToolError(1, "PROMPT_ERROR", "prompt path is not a regular file")
281:         if info.st_size > HARD_MAX_PROMPT_BYTES:
282:             raise ToolError(
283:                 7,
284:                 "PROMPT_TOO_LARGE",
285:                 "prompt exceeds hard limit of %d bytes" % HARD_MAX_PROMPT_BYTES,
286:             )
287:         chunks = []
288:         remaining = HARD_MAX_PROMPT_BYTES + 1
289:         while remaining > 0:
290:             block = os.read(fd, min(1024 * 1024, remaining))
291:             if not block:
292:                 break
293:             chunks.append(block)
294:             remaining -= len(block)
295:         data = b"".join(chunks)
296:         if len(data) > HARD_MAX_PROMPT_BYTES:
297:             raise ToolError(
298:                 7,
299:                 "PROMPT_TOO_LARGE",
300:                 "prompt exceeds hard limit of %d bytes" % HARD_MAX_PROMPT_BYTES,
301:             )
302:     finally:
303:         os.close(fd)
304:     try:
305:         text = data.decode("utf-8")
306:     except UnicodeDecodeError:
307:         raise ToolError(1, "PROMPT_NOT_UTF8", "prompt file must be valid UTF-8")
308:     if not text.strip():
309:         raise ToolError(1, "PROMPT_EMPTY", "prompt file is empty")
