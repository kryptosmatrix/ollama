645: def append_audit(log_path, value):
646:     flags = os.O_WRONLY | os.O_APPEND | os.O_CREAT
647:     if hasattr(os, "O_NOFOLLOW"):
648:         flags |= os.O_NOFOLLOW
649:     try:
650:         fd = os.open(str(log_path), flags, 0o600)
651:         info = os.fstat(fd)
652:         if not stat.S_ISREG(info.st_mode):
653:             raise OSError(errno.EINVAL, "audit path is not a regular file")
654:         os.fchmod(fd, 0o600)
655:         fcntl.flock(fd, fcntl.LOCK_EX)
656:         encoded = (json.dumps(value, sort_keys=True) + "\n").encode("utf-8")
657:         view = memoryview(encoded)
658:         while view:
659:             written = os.write(fd, view)
660:             if written <= 0:
661:                 raise OSError(errno.EIO, "zero-byte audit write")
662:             view = view[written:]
663:         os.fsync(fd)
664:     except OSError as exc:
665:         raise ToolError(5, "AUDIT_WRITE_FAILED", "cannot write audit log: %s" % safe_display(exc))
666:     finally:
667:         if "fd" in locals():
668:             os.close(fd)
