383:     def request(self, method, path, body, timeout, response_limit):
384:         encoded = None
385:         headers = {"Accept": "application/json", "Connection": "close"}
386:         if body is not None:
387:             encoded = json.dumps(
388:                 body, ensure_ascii=False, separators=(",", ":")
389:             ).encode("utf-8")
390:             headers["Content-Type"] = "application/json"
391:             headers["Content-Length"] = str(len(encoded))
392:         connection = http.client.HTTPConnection(LOOPBACK_HOST, self.port, timeout=timeout)
393:         try:
394:             connection.request(method, path, body=encoded, headers=headers)
395:             response = connection.getresponse()
396:             raw = response.read(response_limit + 1)
397:             if len(raw) > response_limit:
398:                 raise ToolError(
399:                     7,
400:                     "RESPONSE_TOO_LARGE",
401:                     "HTTP response exceeded %d bytes" % response_limit,
402:                 )
403:             if response.status < 200 or response.status >= 300:
404:                 message = safe_display(raw.decode("utf-8", errors="replace"))
405:                 raise ToolError(
406:                     4,
407:                     "HTTP_ERROR",
408:                     "Ollama HTTP %d: %s" % (response.status, message),
409:                 )
410:             return raw
411:         except ToolError:
412:             raise
413:         except (socket.timeout, TimeoutError):
414:             raise ToolError(
415:                 2,
416:                 "SERVICE_TIMEOUT",
417:                 "loopback Ollama request timed out",
418:             )
419:         except (ConnectionError, OSError, http.client.HTTPException) as exc:
420:             raise ToolError(
421:                 2,
422:                 "SERVICE_UNAVAILABLE",
423:                 "loopback Ollama request failed: %s" % safe_display(exc),
424:             )
425:         finally:
426:             connection.close()
