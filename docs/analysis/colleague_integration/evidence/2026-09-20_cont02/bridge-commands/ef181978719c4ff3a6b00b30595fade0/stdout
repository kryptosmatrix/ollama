603: def safe_write_bytes(path, data):
604:     flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
605:     if hasattr(os, "O_NOFOLLOW"):
606:         flags |= os.O_NOFOLLOW
607:     try:
608:         fd = os.open(str(path), flags, 0o600)
609:         try:
610:             view = memoryview(data)
611:             while view:
612:                 written = os.write(fd, view)
613:                 if written <= 0:
614:                     raise OSError(errno.EIO, "zero-byte artefact write")
615:                 view = view[written:]
616:             os.fsync(fd)
617:         finally:
618:             os.close(fd)
619:     except OSError as exc:
620:         raise ToolError(5, "ARTEFACT_WRITE_FAILED", "cannot write artefact: %s" % safe_display(exc))
