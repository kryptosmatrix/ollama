473: def find_model(models, requested):
474:     found = []
475:     for item in models:
476:         if not isinstance(item, dict):
477:             continue
478:         name = item.get("name", item.get("model"))
479:         if name == requested:
480:             found.append(item)
481:     if not found:
482:         raise ToolError(2, "MODEL_NOT_FOUND", "model is not installed: %s" % requested)
483:     if len(found) != 1:
484:         raise ToolError(2, "MODEL_METADATA_INVALID", "duplicate records for model: %s" % requested)
485:     item = found[0]
486:     digest = validate_digest(item.get("digest"), "model digest")
487:     capabilities = item.get("capabilities")
488:     if capabilities is not None:
489:         if not isinstance(capabilities, list) or any(
490:             not isinstance(value, str) for value in capabilities
491:         ):
492:             raise ToolError(2, "MODEL_METADATA_INVALID", "model capabilities are invalid")
493:         if len(capabilities) > 64 or any(len(value) > 256 for value in capabilities):
494:             raise ToolError(2, "MODEL_METADATA_INVALID", "model capabilities are unbounded")
495:         if "completion" not in capabilities:
496:             raise ToolError(
497:                 2,
498:                 "MODEL_NOT_COMPLETION_CAPABLE",
499:                 "model does not advertise completion capability: %s" % requested,
500:             )
501:     raw_details = item.get("details") if isinstance(item.get("details"), dict) else {}
502:     context_length = raw_details.get("context_length")
503:     if context_length is not None and (
504:         not isinstance(context_length, int) or isinstance(context_length, bool)
505:     ):
506:         raise ToolError(2, "MODEL_METADATA_INVALID", "model context_length is invalid")
507:     details = {}
508:     for key in (
509:         "format",
510:         "family",
511:         "parameter_size",
512:         "quantization_level",
513:         "embedding_length",
514:     ):
515:         value = raw_details.get(key)
516:         if isinstance(value, str):
517:             details[key] = safe_display(value, 256)
518:         elif isinstance(value, int) and not isinstance(value, bool):
519:             details[key] = value
520:     families = raw_details.get("families")
521:     if isinstance(families, list) and len(families) <= 64 and all(
522:         isinstance(value, str) and len(value) <= 256 for value in families
523:     ):
524:         details["families"] = [safe_display(value, 256) for value in families]
525:     if context_length is not None:
526:         details["context_length"] = context_length
527:     return {
528:         "name": requested,
529:         "digest": digest,
530:         "size": item.get("size") if isinstance(item.get("size"), int) else None,
531:         "modified_at": safe_display(item.get("modified_at"), 128)
532:         if item.get("modified_at") is not None
533:         else None,
534:         "capabilities": capabilities,
535:         "details": details,
536:         "context_length": context_length,
537:     }
