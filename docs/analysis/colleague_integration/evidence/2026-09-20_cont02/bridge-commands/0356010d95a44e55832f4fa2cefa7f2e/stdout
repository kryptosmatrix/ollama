218: // buildRunMessages sanitizes the provided message history, runs the preflight
219: // prompt-budget check, and returns the initial message list for the run. It
220: // emits an EventError and returns it if the preflight check fails.
221: func (s *Session) buildRunMessages(ctx context.Context, runID string, opts RunOptions) ([]api.Message, error) {
222: 	messages := make([]api.Message, 0, len(opts.Messages)+len(opts.NewMessages))
223: 	for _, msg := range opts.Messages {
224: 		messages = append(messages, sanitizeMessageForRun(msg))
225: 	}
226: 	for _, msg := range opts.NewMessages {
227: 		msg = sanitizeMessageForRun(msg)
228: 		messages = append(messages, msg)
229: 	}
230: 
231: 	if err := s.checkPreflightPromptBudget(opts, messages); err != nil {
232: 		s.emit(newErrorEvent(newEventMetadata(runID, opts), err.Error()))
233: 		return nil, err
234: 	}
235: 	return messages, nil
236: }
