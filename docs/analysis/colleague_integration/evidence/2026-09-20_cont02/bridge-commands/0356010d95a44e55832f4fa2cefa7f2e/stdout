222: 		m.detectedToolCalls = append(m.detectedToolCalls, newChatEntry(chatEntry{
223: 			role:   "tool",
224: 			label:  toolInvocationLabel(call.Function.Name, args),
225: 			detail: call.Function.Name,
226: 			status: "queued",
227: 			toolID: call.ID,
228: 			args:   args,
229: 		}))
230: 	}
