137: 			idx = len(m.entries) - 1
138: 		}
139: 		m.entries[idx].content = event.Content
140: 		m.entries[idx].label = toolInvocationLabel(event.ToolName, event.Args)
141: 		m.entries[idx].detail = event.ToolName
142: 		m.entries[idx].status = status
143: 		if status != "denied" {
144: 			m.entries[idx].err = event.Error
145: 		}
146: 		m.entries[idx].toolID = event.ToolCallID
147: 		m.entries[idx].args = event.Args
148: 		m.entries[idx].startedAt = startedAt
149: 		m.entries[idx].finishedAt = time.Now()
150: 		m.applyToolOutputModeTo(idx)
151: 		m.markEntryDirty(idx)
