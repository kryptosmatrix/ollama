1002: // TruncateConfig configures content truncation via Truncate.
1003: type TruncateConfig struct {
1004: 	MaxRunes           int    // rune limit; <= 0 means full omission
1005: 	HeadTail           bool   // true = head + tail split; false = head only
1006: 	HeadPct            int    // percentage of MaxRunes for head (e.g. 75); tail gets the rest
1007: 	Label              string // e.g. "tool output", "summary", "stdout"
1008: 	Hint               string // guidance text appended to marker (optional)
1009: 	FullOmissionPrefix string // marker prefix when MaxRunes <= 0
1010: }
1011: 
1012: // Truncate truncates content to at most cfg.MaxRunes runes. When HeadTail is
1013: // true, it preserves the first HeadPct% and last (100-HeadPct)% of the budget
1014: // with a marker between; otherwise it keeps only the head. MaxRunes <= 0
1015: // triggers full omission using FullOmissionPrefix. All token counts in
1016: // markers use ApproximateTokens.
1017: func Truncate(content string, cfg TruncateConfig) string {
1018: 	runes := []rune(content)
1019: 	total := len(runes)
1020: 
1021: 	if cfg.MaxRunes <= 0 {
1022: 		return fmt.Sprintf("%s omitted ~%d tokens.%s]", cfg.FullOmissionPrefix, ApproximateTokens(total), truncHint(cfg.Hint))
1023: 	}
1024: 	if total <= cfg.MaxRunes {
1025: 		return content
1026: 	}
1027: 
1028: 	if !cfg.HeadTail {
1029: 		head := cfg.MaxRunes
1030: 		omitted := total - head
1031: 		return string(runes[:head]) + TruncMarker(cfg.Label, head, 0, omitted, false, cfg.Hint)
1032: 	}
1033: 
1034: 	head := cfg.MaxRunes * cfg.HeadPct / 100
1035: 	tail := cfg.MaxRunes - head
1036: 	omitted := total - head - tail
1037: 	return string(runes[:head]) + TruncMarker(cfg.Label, head, tail, omitted, true, cfg.Hint) + string(runes[len(runes)-tail:])
1038: }
1039: 
1040: func truncHint(hint string) string {
1041: 	hint = strings.TrimSpace(hint)
1042: 	if hint == "" {
1043: 		return ""
1044: 	}
1045: 	if !strings.HasSuffix(hint, ".") {
1046: 		hint += "."
1047: 	}
1048: 	return " " + hint
1049: }
1050: 
1051: // TruncMarker formats a truncation marker with consistent wording. head and
1052: // tail are rune counts; omitted is the count of runes removed. headTail
1053: // selects the head+tail vs head-only format. hint is optional guidance text.
1054: func TruncMarker(label string, head, tail, omitted int, headTail bool, hint string) string {
1055: 	var b strings.Builder
1056: 	b.WriteString("\n\n[")
1057: 	b.WriteString(label)
1058: 	b.WriteString(" truncated: ")
1059: 	if headTail {
1060: 		fmt.Fprintf(&b, "showing first ~%d tokens and last ~%d tokens; ", ApproximateTokens(head), ApproximateTokens(tail))
1061: 	} else {
1062: 		fmt.Fprintf(&b, "showing first ~%d tokens; ", ApproximateTokens(head))
1063: 	}
1064: 	fmt.Fprintf(&b, "omitted ~%d tokens.%s]", ApproximateTokens(omitted), truncHint(hint))
1065: 	if headTail {
1066: 		b.WriteString("\n\n")
1067: 	}
1068: 	return b.String()
1069: }
1070: 
1071: func toolOutputFullyOmitted(content string) bool {
1072: 	return strings.HasPrefix(content, toolOutputFullOmissionPrefix)
1073: }
1074: 
1075: // ApproximateTokens estimates token count from a character/byte count using
1076: // the standard ~4 chars-per-token heuristic. It is intentionally rough; all
1077: // callers use it only for sizing/truncation decisions, not billing.
1078: func ApproximateTokens(n int) int {
1079: 	if n <= 0 {
1080: 		return 0
1081: 	}
1082: 	return max(1, (n+3)/4)
1083: }
