204: func (m *chatModel) addDetectedToolCalls(calls []api.ToolCall) {
205: 	if len(calls) == 0 {
206: 		return
207: 	}
208: 	seen := make(map[string]struct{}, len(m.detectedToolCalls)+len(calls))
209: 	for _, entry := range m.detectedToolCalls {
210: 		if entry.toolID != "" {
211: 			seen[entry.toolID] = struct{}{}
212: 		}
213: 	}
214: 	for _, call := range calls {
215: 		if call.ID != "" {
