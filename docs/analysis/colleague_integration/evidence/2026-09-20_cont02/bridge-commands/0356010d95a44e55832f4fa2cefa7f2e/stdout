385: func (s *Session) chatRound(ctx context.Context, runID string, opts RunOptions, messages []api.Message, latest *api.ChatResponse) (api.Message, []api.ToolCall, bool, error) {
386: 	meta := newEventMetadata(runID, opts)
387: 	var tools api.Tools
388: 	if !s.DisableTools {
389: 		tools = s.availableTools()
390: 	}
391: 	req := buildChatRequest(opts, messages, tools)
392: 
393: 	assistant := api.Message{Role: "assistant"}
394: 	var pendingToolCalls []api.ToolCall
395: 
396: 	err := s.Client.Chat(ctx, &req, func(response api.ChatResponse) error {
397: 		if response.Message.Role != "" {
398: 			assistant.Role = response.Message.Role
399: 		}
400: 
401: 		if messageEmpty(response.Message) {
402: 			*latest = response
403: 			return nil
404: 		}
405: 
406: 		if response.Message.Thinking != "" {
407: 			assistant.Thinking += response.Message.Thinking
408: 			if err := s.emit(newThinkingDelta(meta, response.Message.Thinking)); err != nil {
409: 				return err
410: 			}
411: 		}
412: 
413: 		if response.Message.Content != "" {
414: 			assistant.Content += response.Message.Content
415: 			if err := s.emit(newMessageDelta(meta, response.Message.Content)); err != nil {
416: 				return err
417: 			}
418: 		}
419: 
420: 		if len(response.Message.ToolCalls) > 0 {
421: 			assistant.ToolCalls = append(assistant.ToolCalls, response.Message.ToolCalls...)
422: 			pendingToolCalls = append(pendingToolCalls, response.Message.ToolCalls...)
423: 			if err := s.emit(newToolCallDetected(meta, response.Message.ToolCalls)); err != nil {
424: 				return err
425: 			}
426: 		}
427: 
428: 		*latest = response
429: 		return nil
430: 	})
431: 	if err != nil {
432: 		if isContextCanceledError(ctx, err) {
433: 			return assistant, pendingToolCalls, true, nil
434: 		}
435: 		return assistant, pendingToolCalls, false, err
436: 	}
437: 
438: 	return assistant, pendingToolCalls, false, nil
439: }
