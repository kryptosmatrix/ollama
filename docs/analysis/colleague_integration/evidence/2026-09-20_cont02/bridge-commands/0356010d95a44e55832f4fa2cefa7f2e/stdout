330: func (s *Session) runCompactionStep(ctx context.Context, st *runState) error {
331: 	opts := st.opts
332: 	meta := newEventMetadata(st.runID, opts)
333: 	var err error
334: 	if st.toolBatch != nil && len(st.toolBatch.overflows) > 0 {
335: 		st.messages, st.compactionSkipNotified, err = s.compactForToolOutputOverflow(ctx, st.runID, opts, st.messages, st.latest, st.assistant, st.toolBatch.messages, st.toolBatch.overflows, st.compactionSkipNotified)
336: 	} else {
337: 		st.messages, st.compactionSkipNotified, err = s.maybeCompact(ctx, st.runID, opts, st.messages, st.latest, st.compactionSkipNotified)
338: 	}
339: 	if err != nil {
340: 		s.emit(newErrorEvent(meta, err.Error()))
341: 		st.finishError(err)
342: 		return nil
343: 	}
344: 
345: 	if st.toolBatch == nil {
346: 		if st.canceled {
347: 			st.finishCanceled()
348: 		} else {
349: 			st.finishDone()
350: 		}
351: 		return nil
352: 	}
353: 
354: 	switch st.toolBatch.stop {
355: 	case toolExecutionDenied:
356: 		st.finishDenied()
357: 	case toolExecutionCanceled:
358: 		st.finishCanceled()
359: 	default:
360: 		st.toolRounds++
361: 		st.assistant = api.Message{}
362: 		st.pendingToolCalls = nil
363: 		st.toolBatch = nil
364: 		st.phase = runPhaseModel
365: 	}
366: 	return nil
367: }
