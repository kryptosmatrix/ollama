869: // toolMessageWithBudget sizes a tool result message to fit within a token
870: // budget (compaction threshold or context window). baseTokens is the
871: // pre-computed estimate of everything before this message; budgetTokens is
872: // the ceiling. If the message already fits, it is returned with only the
873: // small-context rune cap applied.
874: func (s *Session) toolMessageWithBudget(toolName, toolCallID, content string, opts RunOptions, baseTokens, budgetTokens int) api.Message {
875: 	maxRunes := maxToolResultRunes
876: 	if limit := smallContextToolResultLimitRunes(s.contextWindowTokens(opts)); limit > 0 {
877: 		maxRunes = min(maxRunes, limit)
878: 	}
879: 
880: 	if budgetTokens <= 0 {
881: 		return toolMessageWithLimit(toolName, toolCallID, content, maxRunes)
882: 	}
883: 
884: 	msg := toolMessageWithLimit(toolName, toolCallID, content, maxRunes)
885: 	projectedTokens := baseTokens + estimateMessagesTokens([]api.Message{msg})
886: 	if projectedTokens < budgetTokens {
887: 		return msg
888: 	}
889: 
890: 	overheadTokens := estimateMessagesTokens([]api.Message{{
891: 		Role:       "tool",
892: 		ToolName:   toolName,
893: 		ToolCallID: toolCallID,
894: 	}})
895: 	// Keep oversized tool output below the budget before it is appended to
896: 	// history. This is especially important for <=8k contexts: the next step
897: 	// must still have enough room to compact and continue the same user
898: 	// request instead of asking the user to prompt again.
899: 	availableRunes := (budgetTokens - baseTokens - overheadTokens - toolTruncationMarkerReserveTokens) * 4
900: 	maxRunes = min(maxRunes, max(0, availableRunes))
901: 	msg.Content = truncateToolResultContentTo(content, maxRunes)
902: 	return msg
903: }
