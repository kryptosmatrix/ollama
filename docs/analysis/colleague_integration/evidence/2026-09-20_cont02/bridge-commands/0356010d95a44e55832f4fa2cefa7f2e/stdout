152: func (s *Session) Run(ctx context.Context, opts RunOptions) (*RunResult, error) {
153: 	if err := s.validateRun(opts); err != nil {
154: 		return nil, err
155: 	}
156: 	if s.ApprovalState == nil {
157: 		s.ApprovalState = &ApprovalState{}
158: 	}
159: 	runID := uuid.NewString()
160: 	messages, err := s.buildRunMessages(ctx, runID, opts)
161: 	if err != nil {
162: 		return nil, err
163: 	}
164: 	activatedSkill, err := s.activateSkill(ctx, runID, opts)
165: 	if err != nil {
166: 		s.emit(newErrorEvent(newEventMetadata(runID, opts), err.Error()))
167: 		return nil, err
168: 	}
169: 	if len(activatedSkill) > 0 {
170: 		messages = append(messages, activatedSkill...)
171: 		if err := s.checkPreflightPromptBudget(opts, messages); err != nil {
172: 			s.emit(newErrorEvent(newEventMetadata(runID, opts), err.Error()))
173: 			return nil, err
174: 		}
175: 	}
176: 
177: 	st := runState{
178: 		runID:         runID,
179: 		opts:          opts,
180: 		phase:         runPhaseModel,
181: 		messages:      messages,
182: 		maxToolRounds: resolvedMaxToolRounds(opts.MaxToolRounds),
183: 	}
184: 	for {
185: 		switch st.phase {
186: 		case runPhaseModel:
187: 			if err := s.runModelStep(ctx, &st); err != nil {
188: 				return nil, err
189: 			}
190: 		case runPhaseTools:
191: 			if err := s.runToolStep(ctx, &st); err != nil {
192: 				return nil, err
193: 			}
194: 		case runPhaseCompact:
195: 			if err := s.runCompactionStep(ctx, &st); err != nil {
196: 				return nil, err
197: 			}
198: 		case runPhaseDone:
199: 			return s.finishRun(ctx, &st)
200: 		}
201: 	}
202: }
