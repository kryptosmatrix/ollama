71: func (m chatModel) finishManualCompaction(msg chatCompactDoneMsg) (tea.Model, tea.Cmd) {
72: 	wasCanceling := m.status == "canceling"
73: 	m.compacting = false
74: 	m.compactEvents = nil
75: 	m.cancel = nil
76: 	m.compactingTokens = 0
77: 	if wasCanceling || isChatContextCanceledError(msg.err) {
78: 		m.status = "compact canceled"
79: 		return m.withFlowTranscriptFlush(nil)
80: 	}
81: 	if msg.err != nil {
