82: 				m.thinkingTokens += approximateTokenCount(event.Thinking)
83: 			}
84: 			idx := m.ensureLiveAssistantMessage()
85: 			m.liveMessages[idx].Thinking += event.Thinking
86: 			m.syncThinkingEntry()
