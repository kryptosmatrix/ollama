470: func (s *Session) executeToolCalls(ctx context.Context, runID string, opts RunOptions, messages []api.Message, calls []api.ToolCall) (toolBatchResult, error) {
471: 	meta := newEventMetadata(runID, opts)
472: 	batch := toolBatchResult{
473: 		messages: make([]api.Message, 0, len(calls)),
474: 	}
475: 	// Pre-compute the full-history token estimate once per batch instead of
476: 	// re-marshaling the entire history for each tool call. Per-call deltas
477: 	// (tool messages already appended this batch) are tracked in batchTokens
478: 	// and added to historyTokens for a lightweight running total.
479: 	historyTokens := s.estimateRunPromptTokens(opts, messages)
480: 	batchTokens := 0
481: 
482: 	type plannedToolCall struct {
483: 		call       api.ToolCall
484: 		tool       Tool
485: 		toolName   string
486: 		args       map[string]any
487: 		workingDir string
488: 	}
489: 	plans := make([]plannedToolCall, 0, len(calls))
490: 	batchWorkingDir := s.currentWorkingDir()
491: 	approvalReq := ApprovalRequest{WorkingDir: batchWorkingDir}
492: 	for _, call := range calls {
493: 		toolName := call.Function.Name
494: 		args := call.Function.Arguments.ToMap()
495: 		tool, ok := s.Tools.Get(toolName)
496: 		plans = append(plans, plannedToolCall{
497: 			call:       call,
498: 			tool:       tool,
499: 			toolName:   toolName,
500: 			args:       args,
501: 			workingDir: batchWorkingDir,
502: 		})
503: 		if ok && s.needsApproval(tool, toolName, args) {
504: 			approvalReq.AddToolCall(call.ID, toolName, toolApprovalScope(tool, toolName, args), args)
505: 		}
506: 	}
507: 
508: 	if len(approvalReq.Calls) > 0 {
509: 		approvalResult, err := s.authorizeToolCalls(ctx, approvalReq)
510: 		if err != nil {
511: 			if ctx.Err() != nil {
512: 				skipped, skipErr := s.skipToolCalls(ctx, runID, opts, calls, "Tool execution skipped because the run was canceled.")
513: 				if skipErr != nil {
514: 					return toolBatchResult{}, skipErr
515: 				}
516: 				batch.messages = append(batch.messages, skipped...)
517: 				batch.stop = toolExecutionCanceled
518: 				return batch, nil
519: 			}
520: 			return toolBatchResult{}, err
521: 		}
522: 		if !approvalResult.Allow {
523: 			content := approvalResult.Reason
524: 			if content == "" {
525: 				content = "Tool execution denied."
526: 			}
527: 			for _, plan := range plans {
528: 				msg := s.toolMessageForContext(plan.toolName, plan.call.ID, content, opts, historyTokens+batchTokens)
529: 				batch.messages = append(batch.messages, msg)
530: 				batchTokens += estimateMessagesTokens([]api.Message{msg})
531: 				deniedContent := msg.Content
532: 				if emitErr := s.emit(newToolFinished(meta, "denied", plan.call.ID, plan.toolName, "", plan.args, deniedContent, deniedContent)); emitErr != nil {
533: 					return toolBatchResult{}, emitErr
534: 				}
535: 			}
536: 			batch.stop = toolExecutionDenied
537: 			return batch, nil
538: 		}
539: 	}
540: 
541: 	for i, plan := range plans {
542: 		call := plan.call
543: 		toolName := plan.toolName
544: 		args := plan.args
545: 		if ctx.Err() != nil {
546: 			skipped, skipErr := s.skipToolCalls(ctx, runID, opts, calls[i:], "Tool execution skipped because the run was canceled.")
547: 			if skipErr != nil {
548: 				return toolBatchResult{}, skipErr
549: 			}
550: 			batch.messages = append(batch.messages, skipped...)
551: 			batch.stop = toolExecutionCanceled
552: 			return batch, nil
553: 		}
554: 		if plan.tool == nil {
555: 			content := fmt.Sprintf("Error: unknown tool: %s", toolName)
556: 			msg := s.toolMessageForContext(toolName, call.ID, content, opts, historyTokens+batchTokens)
557: 			batch.messages = append(batch.messages, msg)
558: 			batchTokens += estimateMessagesTokens([]api.Message{msg})
559: 			content = msg.Content
560: 			if toolOutputFullyOmitted(content) {
561: 				batch.overflows = append(batch.overflows, toolOutputOverflow{toolName: toolName, toolCallID: call.ID, content: fmt.Sprintf("Error: unknown tool: %s", toolName)})
562: 			}
563: 			if emitErr := s.emit(newToolFinished(meta, "failed", call.ID, toolName, "", args, content, fmt.Sprintf("unknown tool: %s", toolName))); emitErr != nil {
564: 				return toolBatchResult{}, emitErr
565: 			}
566: 			continue
567: 		}
568: 
569: 		if err := s.emit(newToolStarted(meta, call.ID, toolName, plan.workingDir, args)); err != nil {
570: 			return toolBatchResult{}, err
571: 		}
572: 
573: 		result, err := s.Tools.Execute(ctx, ToolContext{WorkingDir: plan.workingDir}, call)
574: 		if err != nil {
575: 			rawContent := fmt.Sprintf("Error: %v", err)
576: 			msg := s.toolMessageForContext(toolName, call.ID, rawContent, opts, historyTokens+batchTokens)
577: 			batch.messages = append(batch.messages, msg)
578: 			batchTokens += estimateMessagesTokens([]api.Message{msg})
579: 			content := msg.Content
580: 			if toolOutputFullyOmitted(content) {
581: 				batch.overflows = append(batch.overflows, toolOutputOverflow{toolName: toolName, toolCallID: call.ID, content: rawContent})
582: 			}
583: 			if emitErr := s.emitIgnoringCanceled(ctx, newToolFinished(meta, "failed", call.ID, toolName, "", args, content, err.Error())); emitErr != nil {
584: 				return toolBatchResult{}, emitErr
585: 			}
586: 			if ctx.Err() != nil {
587: 				skipped, skipErr := s.skipToolCalls(ctx, runID, opts, calls[i+1:], "Tool execution skipped because the run was canceled.")
588: 				if skipErr != nil {
589: 					return toolBatchResult{}, skipErr
590: 				}
591: 				batch.messages = append(batch.messages, skipped...)
592: 				batch.stop = toolExecutionCanceled
593: 				return batch, nil
594: 			}
595: 			continue
596: 		}
597: 
