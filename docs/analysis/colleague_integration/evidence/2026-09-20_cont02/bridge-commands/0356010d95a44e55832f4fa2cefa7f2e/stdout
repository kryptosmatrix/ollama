238: func (s *Session) runModelStep(ctx context.Context, st *runState) error {
239: 	opts := st.opts
240: 	meta := newEventMetadata(st.runID, opts)
241: 
242: 	assistant, pendingToolCalls, canceled, err := s.chatRound(ctx, st.runID, opts, st.messages, &st.latest)
243: 	if err != nil {
244: 		var statusErr api.StatusError
245: 		if errors.As(err, &statusErr) && statusErr.StatusCode >= 500 && st.consecutiveModelErrors < 2 {
246: 			st.consecutiveModelErrors++
247: 			st.messages = append(st.messages, api.Message{
248: 				Role:    "user",
249: 				Content: fmt.Sprintf("Your previous response caused an error: %s\n\nPlease try again with a valid response.", statusErr.ErrorMessage),
250: 			})
251: 			return nil
252: 		}
253: 		s.emit(newErrorEvent(meta, err.Error()))
254: 		return err
255: 	}
256: 	st.consecutiveModelErrors = 0
257: 	st.assistant = assistant
258: 	st.pendingToolCalls = pendingToolCalls
259: 	st.canceled = canceled
260: 
261: 	if !messageEmpty(assistant) {
262: 		st.messages = append(st.messages, assistant)
263: 	}
264: 
265: 	if len(pendingToolCalls) == 0 {
266: 		st.toolBatch = nil
267: 		st.phase = runPhaseCompact
268: 		return nil
269: 	}
270: 
271: 	if canceled {
272: 		skipped, skipErr := s.skipToolCalls(ctx, st.runID, opts, pendingToolCalls, "Tool execution skipped because the run was canceled.")
273: 		if skipErr != nil {
274: 			s.emit(newErrorEvent(meta, skipErr.Error()))
275: 			return skipErr
276: 		}
277: 		st.messages = append(st.messages, skipped...)
278: 		st.finishCanceled()
279: 		return nil
280: 	}
281: 
282: 	if s.DisableTools {
283: 		batch, skipErr := s.disabledToolCalls(ctx, st.runID, opts, st.messages, pendingToolCalls)
284: 		if skipErr != nil {
285: 			s.emit(newErrorEvent(meta, skipErr.Error()))
286: 			return skipErr
287: 		}
288: 		st.messages = append(st.messages, batch.messages...)
289: 		st.toolBatch = &batch
290: 		st.phase = runPhaseCompact
291: 		return nil
292: 	}
293: 
294: 	if s.Tools == nil {
295: 		st.finishDone()
296: 		return nil
297: 	}
298: 
299: 	if st.maxToolRounds >= 0 && st.toolRounds >= st.maxToolRounds {
300: 		content := fmt.Sprintf("Tool execution skipped because the max tool-round limit of %d was reached. Send another message to continue.", st.maxToolRounds)
301: 		toolMessages, skipErr := s.skipToolCalls(ctx, st.runID, opts, pendingToolCalls, content)
302: 		if skipErr != nil {
303: 			s.emit(newErrorEvent(meta, skipErr.Error()))
304: 			return skipErr
305: 		}
306: 		st.messages = append(st.messages, toolMessages...)
307: 		err := fmt.Errorf("tool round limit reached after %d rounds; send another message to continue", st.maxToolRounds)
308: 		s.emit(newErrorEvent(meta, err.Error()))
309: 		st.finishError(err)
310: 		return nil
311: 	}
312: 
313: 	st.phase = runPhaseTools
314: 	return nil
315: }
