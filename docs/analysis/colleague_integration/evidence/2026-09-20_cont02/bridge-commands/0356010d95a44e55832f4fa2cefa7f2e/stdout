318: 	batch, err := s.executeToolCalls(ctx, st.runID, st.opts, st.messages, st.pendingToolCalls)
319: 	if err != nil {
320: 		s.emit(newErrorEvent(newEventMetadata(st.runID, st.opts), err.Error()))
321: 		return err
322: 	}
323: 
324: 	st.messages = append(st.messages, batch.messages...)
325: 	st.toolBatch = &batch
326: 	st.phase = runPhaseCompact
327: 	return nil
328: }
