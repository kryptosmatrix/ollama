441: func buildChatRequest(opts RunOptions, messages []api.Message, tools api.Tools) api.ChatRequest {
442: 	requestMessages := sanitizeMessagesForRequest(messages)
443: 	if strings.TrimSpace(opts.SystemPrompt) != "" {
444: 		withSystem := make([]api.Message, 0, len(requestMessages)+1)
445: 		withSystem = append(withSystem, api.Message{Role: "system", Content: opts.SystemPrompt})
446: 		requestMessages = append(withSystem, requestMessages...)
447: 	}
448: 
449: 	format := opts.Format
450: 	if format == "json" {
451: 		format = `"` + format + `"`
452: 	}
453: 
454: 	req := api.ChatRequest{
455: 		Model:    opts.Model,
456: 		Messages: requestMessages,
457: 		Format:   json.RawMessage(format),
458: 		Options:  opts.Options,
459: 		Think:    opts.Think,
460: 	}
461: 	if opts.KeepAlive != nil {
462: 		req.KeepAlive = opts.KeepAlive
463: 	}
464: 	if len(tools) > 0 {
465: 		req.Tools = tools
466: 	}
467: 	return req
468: }
