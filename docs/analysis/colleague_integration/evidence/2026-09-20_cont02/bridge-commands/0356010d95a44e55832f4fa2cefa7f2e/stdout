369: func (s *Session) finishRun(ctx context.Context, st *runState) (*RunResult, error) {
370: 	if st.finish.status != "" {
371: 		event := newRunFinished(newEventMetadata(st.runID, st.opts), st.finish.status)
372: 		var err error
373: 		if st.finish.ignoreCanceled {
374: 			err = s.emitIgnoringCanceled(ctx, event)
375: 		} else {
376: 			err = s.emit(event)
377: 		}
378: 		if err != nil {
379: 			return nil, err
380: 		}
381: 	}
382: 	return &RunResult{Messages: st.messages, Latest: st.latest, WorkingDir: s.WorkingDir}, st.finish.err
383: }
