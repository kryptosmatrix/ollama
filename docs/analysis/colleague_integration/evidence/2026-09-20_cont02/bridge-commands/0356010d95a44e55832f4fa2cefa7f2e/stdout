83: 		m.status = "compact skipped"
84: 		return m.withFlowTranscriptFlush(nil)
85: 	}
86: 	if !msg.result.Compacted {
87: 		m.entries = append(m.entries, newChatEntry(chatEntry{role: "system", content: coreagent.CompactionSkippedMessage(msg.result.Reason)}))
88: 		m.status = "compact skipped"
89: 		return m.withFlowTranscriptFlush(nil)
90: 	}
91: 
92: 	m.messages = msg.result.Messages
93: 	m.liveMessages = nil
94: 	m.entries = entriesFromMessages(m.messages)
95: 	m.contextTokens = m.estimatePromptTokens(m.messages, "")
96: 	m.contextEstimate = true
97: 	m.scroll = 0
98: 	m.flowPrintedLines = 0
99: 	m.status = "compacted"
100: 	return m.withFlowTranscriptFlush(nil)
101: }

