991: func truncateToolResultContentTo(content string, maxRunes int) string {
992: 	return Truncate(content, TruncateConfig{
993: 		MaxRunes:           maxRunes,
994: 		HeadTail:           true,
995: 		HeadPct:            75,
996: 		Label:              "tool output",
997: 		Hint:               "Use a narrower command, line range, or search query if more detail is needed.",
998: 		FullOmissionPrefix: toolOutputFullOmissionPrefix,
999: 	})
1000: }
