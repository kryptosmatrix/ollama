15: const serverConfigFilename = "server.json"
16: 
17: type serverConfig struct {
18: 	DisableOllamaCloud bool `json:"disable_ollama_cloud,omitempty"`
19: }
20: 
21: // CloudDisabled returns whether cloud features should be disabled.
22: // The source of truth is: OLLAMA_NO_CLOUD OR ~/.ollama/server.json:disable_ollama_cloud.
23: func (s *Store) CloudDisabled() (bool, error) {
24: 	disabled, _, err := s.CloudStatus()
25: 	return disabled, err
26: }
27: 
28: // CloudStatus returns whether cloud is disabled and the source of that decision.
29: // Source is one of: "none", "env", "config", "both".
30: func (s *Store) CloudStatus() (bool, string, error) {
31: 	if err := s.ensureDB(); err != nil {
32: 		return false, "", err
33: 	}
34: 
35: 	configDisabled, err := readServerConfigCloudDisabled()
36: 	if err != nil {
37: 		return false, "", err
38: 	}
39: 
40: 	envDisabled := envconfig.NoCloudEnv()
41: 	return envDisabled || configDisabled, cloudStatusSource(envDisabled, configDisabled), nil
42: }
43: 
44: // SetCloudEnabled writes the cloud setting to ~/.ollama/server.json.
45: func (s *Store) SetCloudEnabled(enabled bool) error {
46: 	if err := s.ensureDB(); err != nil {
47: 		return err
48: 	}
49: 	return setCloudEnabled(enabled)
50: }
51: 
52: func setCloudEnabled(enabled bool) error {
53: 	configPath, err := serverConfigPath()
54: 	if err != nil {
55: 		return err
56: 	}
57: 
58: 	if err := os.MkdirAll(filepath.Dir(configPath), 0o755); err != nil {
59: 		return fmt.Errorf("create server config directory: %w", err)
60: 	}
61: 
62: 	configMap := map[string]any{}
63: 	if data, err := os.ReadFile(configPath); err == nil {
64: 		if err := json.Unmarshal(data, &configMap); err != nil {
65: 			// If the existing file is invalid JSON, overwrite with a fresh object.
66: 			configMap = map[string]any{}
67: 		}
68: 	} else if !errors.Is(err, os.ErrNotExist) {
69: 		return fmt.Errorf("read server config: %w", err)
70: 	}
71: 
72: 	configMap["disable_ollama_cloud"] = !enabled
73: 
74: 	data, err := json.MarshalIndent(configMap, "", "  ")
75: 	if err != nil {
76: 		return fmt.Errorf("marshal server config: %w", err)
77: 	}
78: 	data = append(data, '\n')
79: 
80: 	if err := os.WriteFile(configPath, data, 0o644); err != nil {
81: 		return fmt.Errorf("write server config: %w", err)
82: 	}
83: 
84: 	return nil
85: }
86: 
87: func readServerConfigCloudDisabled() (bool, error) {
88: 	configPath, err := serverConfigPath()
89: 	if err != nil {
90: 		return false, err
91: 	}
92: 
93: 	data, err := os.ReadFile(configPath)
94: 	if err != nil {
95: 		if errors.Is(err, os.ErrNotExist) {
96: 			return false, nil
97: 		}
98: 		return false, fmt.Errorf("read server config: %w", err)
99: 	}
100: 
101: 	var cfg serverConfig
102: 	// Invalid or unexpected JSON should not block startup; treat as default.
103: 	if json.Unmarshal(data, &cfg) == nil {
104: 		return cfg.DisableOllamaCloud, nil
105: 	}
106: 	return false, nil
107: }
108: 
109: func serverConfigPath() (string, error) {
110: 	home, err := os.UserHomeDir()
111: 	if err != nil {
112: 		return "", fmt.Errorf("resolve home directory: %w", err)
113: 	}
114: 	return filepath.Join(home, ".ollama", serverConfigFilename), nil
115: }
